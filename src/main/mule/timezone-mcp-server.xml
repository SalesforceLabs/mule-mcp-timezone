<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Global configs (HTTP listener + Anypoint auth request) are in global.xml        -->
    <!-- Sub-flows are each in their own file:                                            -->
    <!--   timezone-tools-list.xml  — tools/list response                                -->
    <!--   timezone-tools-call.xml  — tools/call dispatcher                              -->
    <!--   get-current-time.xml     — get_current_time tool                              -->
    <!--   convert-time.xml         — convert_time tool                                  -->
    <!--   time-difference.xml      — time_difference tool                               -->
    <!--   list-timezones.xml       — list_timezones tool                                -->

    <!-- Optional: enable API Manager autodiscovery if you have an API instance configured.
         Set api.id in config.yaml (or as a CloudHub property) to the numeric API instance ID.
         Requires adding xmlns:api-gateway and its schema location to the <mule> element.
         <api-gateway:autodiscovery apiId="${api.id}" flowRef="mcp-server-flow" doc:name="API Autodiscovery" /> -->

    <!-- Main MCP Server Flow — HTTP listener, CORS, OAuth validation, JSON-RPC routing -->
    <flow name="mcp-server-flow" doc:name="MCP Server Flow">
        <http:listener doc:name="MCP Endpoint"
                       config-ref="mcp-listener-config"
                       path="${mcp.listener.path}"
                       allowedMethods="POST,OPTIONS">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
            </http:error-response>
        </http:listener>

        <!-- Set CORS and Content-Type headers.
             cors.allowedOrigins is defined in config.yaml; override per environment. -->
        <ee:transform doc:name="Set Response Headers">
            <ee:variables>
                <ee:set-variable variableName="outboundHeaders"><![CDATA[%dw 2.0
output application/java
---
{
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": p('cors.allowedOrigins'),
    "Access-Control-Allow-Methods": "POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization"
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <!-- Handle OPTIONS preflight before auth.
             Browsers send OPTIONS without an Authorization header; running it through
             the auth check would always return 401, breaking CORS for all POST calls. -->
        <choice doc:name="Handle OPTIONS Preflight">
            <when expression="#[attributes.method == 'OPTIONS']">
                <ee:transform doc:name="CORS Preflight Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[200]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </when>
            <otherwise>
                <!-- POST requests — extract and validate the Bearer token -->

                <ee:transform doc:name="Extract Auth Header">
                    <ee:variables>
                        <ee:set-variable variableName="authHeader"><![CDATA[%dw 2.0
output application/java
---
attributes.headers['authorization'] default ""]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <choice doc:name="Validate Auth">
                    <when expression="#[!(vars.authHeader contains 'Bearer ')]">
                        <ee:transform doc:name="401 Unauthorized">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "jsonrpc": "2.0",
    "id": null,
    "error": {
        "code": -32000,
        "message": "Unauthorized: Missing or invalid Bearer token"
    }
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA[401]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </when>
                    <otherwise>
                        <!-- Save the original JSON-RPC request; the validation HTTP call overwrites the payload -->
                        <set-variable variableName="mcpRequest" value="#[payload]" doc:name="Save Request Payload"/>

                        <!-- Validate the token: GET /accounts/api/profile with the Bearer token.
                             /accounts/api/profile returns 200 for a valid token and 401 for an invalid one.
                             Works with client-credentials tokens (which have no user).
                             A non-200 or connectivity error marks the request unauthorized.
                             responseTimeout (5 s) is configured on anypoint-auth-config in global.xml. -->
                        <try doc:name="Validate OAuth Token">
                            <http:request method="GET" config-ref="anypoint-auth-config"
                                          path="${anypoint.auth.profilePath}" doc:name="Call Anypoint /profile">
                                <http:headers><![CDATA[#[{"Authorization": vars.authHeader}]]]></http:headers>
                            </http:request>
                            <logger level="INFO" doc:name="Log Auth Success" message="OAuth token validated successfully"/>
                            <error-handler>
                                <on-error-continue type="ANY" doc:name="Token Invalid">
                                    <logger level="WARN" doc:name="Log Auth Failure"
                                            message="#['OAuth token validation failed: ' ++ (error.errorType.identifier default 'UNKNOWN')]"/>
                                    <set-variable variableName="authFailed" value="#[true]" doc:name="Mark Auth Failed"/>
                                </on-error-continue>
                            </error-handler>
                        </try>

                        <set-payload value="#[vars.mcpRequest]" doc:name="Restore Request Payload"/>

                        <choice doc:name="Token Valid?">
                            <when expression="#[vars.authFailed default false]">
                                <ee:transform doc:name="401 Invalid Token">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "jsonrpc": "2.0",
    "id": null,
    "error": {
        "code": -32000,
        "message": "Unauthorized: Invalid or expired OAuth token"
    }
}]]></ee:set-payload>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="httpStatus"><![CDATA[401]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </when>

                            <otherwise>
                                <!-- Parse JSON-RPC request -->
                                <ee:transform doc:name="Parse Request">
                                    <ee:variables>
                                        <ee:set-variable variableName="requestId"><![CDATA[%dw 2.0
output application/java
---
payload.id]]></ee:set-variable>
                                        <ee:set-variable variableName="method"><![CDATA[%dw 2.0
output application/java
---
payload.method]]></ee:set-variable>
                                        <ee:set-variable variableName="params"><![CDATA[%dw 2.0
output application/java
---
payload.params default {}]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>

                                <logger level="INFO" doc:name="Log Request"
                                        message="#['MCP Request - Method: ' ++ (vars.method default 'unknown') ++ ', ID: ' ++ (vars.requestId default 'null')]"/>

                                <!-- Route by JSON-RPC method -->
                                <choice doc:name="Route Method">
                                    <when expression="#[vars.method == 'initialize']">
                                        <ee:transform doc:name="Initialize Response">
                                            <ee:message>
                                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "jsonrpc": "2.0",
    "id": vars.requestId,
    "result": {
        "protocolVersion": p('mcp.protocol.version'),
        "capabilities": {
            "tools": {}
        },
        "serverInfo": {
            "name": "timezone-mcp-server",
            "version": "1.0.0"
        }
    }
}]]></ee:set-payload>
                                            </ee:message>
                                        </ee:transform>
                                    </when>

                                    <when expression="#[vars.method == 'notifications/initialized']">
                                        <logger level="INFO" doc:name="Log Initialized" message="Client initialized notification received"/>
                                        <ee:transform doc:name="Null Response">
                                            <ee:message>
                                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "jsonrpc": "2.0",
    "id": null,
    "result": null
}]]></ee:set-payload>
                                            </ee:message>
                                        </ee:transform>
                                    </when>

                                    <when expression="#[vars.method == 'tools/list']">
                                        <flow-ref doc:name="Tools List" name="timezone-tools-list-flow"/>
                                    </when>

                                    <when expression="#[vars.method == 'tools/call']">
                                        <flow-ref doc:name="Tools Call" name="timezone-tools-call-flow"/>
                                    </when>

                                    <otherwise>
                                        <ee:transform doc:name="Method Not Found">
                                            <ee:message>
                                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "jsonrpc": "2.0",
    "id": vars.requestId,
    "error": {
        "code": -32601,
        "message": "Method not found: " ++ (vars.method default "unknown")
    }
}]]></ee:set-payload>
                                            </ee:message>
                                        </ee:transform>
                                    </otherwise>
                                </choice>
                            </otherwise>
                        </choice>
                    </otherwise>
                </choice>
            </otherwise>
        </choice>

        <!-- Global error handler — catches any unhandled exception and returns
             a well-formed JSON-RPC -32603 Internal Error response. -->
        <error-handler>
            <on-error-continue type="ANY">
                <ee:transform doc:name="Error Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "jsonrpc": "2.0",
    "id": vars.requestId default null,
    "error": {
        "code": -32603,
        "message": "Internal error: " ++ (error.description default "Unknown error")
    }
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[200]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>