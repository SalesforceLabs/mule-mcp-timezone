<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Returns all supported cities grouped by region, with optional region filter. -->
    <sub-flow name="list-timezones-flow" doc:name="List Timezones">
        <ee:transform doc:name="List Available Timezones">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
import citiesByRegion from dw::Timezones

var regionFilter = vars.arguments.region default ""
var filtered = if (regionFilter == "" or regionFilter == null)
    citiesByRegion
else
    { (regionFilter): citiesByRegion[regionFilter] default [] }

var resultText = filtered pluck ((cities, region) ->
    (region as String) ++ ": " ++ (cities joinBy ", ")
) joinBy "\n"
---
{
    "jsonrpc": "2.0",
    "id": vars.requestId,
    "result": {
        "content": [
            {
                "type": "text",
                "text": resultText
            }
        ]
    }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </sub-flow>

</mule>