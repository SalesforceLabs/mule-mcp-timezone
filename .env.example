# Timezone MCP Server — test configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# The test scripts (test-oauth.sh, test-mcp-compliance.sh) load these
# automatically. `.env` is gitignored, so your credentials stay local.

# Your deployed CloudHub endpoint (from Step 4 of the README).
# Example: https://timezone-mcp-server.us-e2.cloudhub.io/mcp
MCP_URL=https://YOUR-APP-URL/mcp

# Connected App credentials (from Step 2.3 of the README).
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET

# Anypoint token endpoint — leave as-is unless you know you need to change it.
TOKEN_ENDPOINT=https://anypoint.mulesoft.com/accounts/api/v2/oauth2/token
